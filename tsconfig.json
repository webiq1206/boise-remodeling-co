{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "shared/costs/**/*.ts",
    "shared/blogContent.ts",
    "shared/contentData.ts",
    "shared/schema.ts",
    "shared/utils.ts",
    "shared/measurementBundle.ts",
    "server/db.ts",
    "server/storage.ts",
    "server/services/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "client",
    "e2e",
    "scripts",
    "*.config.ts",
    "*.config.js",
    "playwright.config.ts",
    "drizzle.config.ts",
    "vite.config.ts",
    "shared/serviceBackgrounds.ts",
    "shared/serviceFieldConfig.ts"
  ]
}
